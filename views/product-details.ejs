<!DOCTYPE html>
<html>
<head>
  <title><%= product.name %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      margin: 0;
      padding: 0;
    }

    .container {
      width: 80%;
      margin: 50px auto;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      display: flex;
      gap: 40px;
    }

    .product-image {
      flex: 1;
    }

    .product-image img {
      width: 100%;
      border-radius: 10px;
    }

    .product-info {
      flex: 1;
    }

    h1 {
      margin-top: 0;
    }

    .price {
      color: green;
      font-size: 24px;
      margin: 15px 0;
    }

    .description {
      margin: 20px 0;
      color: #555;
    }

    .btn {
      display: inline-block;
      padding: 12px 20px;
      background: #007bff;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      margin-right: 10px;
    }

    .btn:hover {
      background: #0056b3;
    }

    .back {
      background: gray;
    }
    .reviews-section{
  width:80%;
  margin:30px auto;
  background:white;
  padding:25px;
  border-radius:10px;
  box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.review-box{
  margin-bottom:15px;
}

.review-form{
  width:80%;
  margin:30px auto;
  background:white;
  padding:25px;
  border-radius:10px;
  box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.review-form textarea{
  width:100%;
  height:80px;
  padding:10px;
}

.review-form button{
  padding:10px 20px;
  background:#28a745;
  color:white;
  border:none;
  border-radius:5px;
  cursor:pointer;
}
  </style>
</head>
<body>

  <div class="container">

    <div class="product-image">
      <img src="<%= product.image %>" alt="<%= product.name %>">
    </div>

    <div class="product-info">
      <h1><%= product.name %></h1>

      <div class="price">₹ <%= product.price %></div>

      <div class="description">
        <%= product.description %>
      </div>

      <a href="#" class="btn">Add to Cart</a>
      <a href="/user/dashboard" class="btn back">Back</a>

    </div>

  </div>
   <!-- end of product container -->


<div class="reviews-section">

<h2>Customer Reviews</h2>

<% if(product.reviews.length === 0) { %>
<p>No reviews yet</p>
<% } %>

<% product.reviews.forEach(review => { %>

<div class="review-box">

<strong><%= review.user.name %></strong>

<p>Rating: <%= review.rating %> ⭐</p>

<p><%= review.comment %></p>

<hr>

</div>

<% }) %>

</div>
<% if(canReview) { %>

<div class="review-form">

<h3>Write a Review</h3>

<form action="/user/review/<%= product._id %>" method="POST">

<label>Rating</label>

<select name="rating">
<option value="5">5 ⭐</option>
<option value="4">4 ⭐</option>
<option value="3">3 ⭐</option>
<option value="2">2 ⭐</option>
<option value="1">1 ⭐</option>
</select>

<br><br>

<textarea name="comment" placeholder="Write your review..." required></textarea>

<br><br>

<button type="submit">Submit Review</button>

</form>

</div>

<% } %>

</body>
</html>