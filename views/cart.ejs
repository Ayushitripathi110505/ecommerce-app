<!DOCTYPE html>
<html>
<head>
<title>Your Cart</title>

<style>
body { font-family: Arial; padding: 30px; background: #f4f6f9; }

h2 { text-align: center; }

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

th, td {
    padding: 12px;
    border-bottom: 1px solid #ddd;
    text-align: center;
}

th {
    background: #2c3e50;
    color: white;
}

td:first-child { text-align: left; }

.btn {
    background: green;
    color: white;
    padding: 8px 14px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.btn:hover { background: darkgreen; }

h3 { text-align: right; margin-top: 20px; }

.empty {
    text-align: center;
    font-size: 18px;
    margin-top: 40px;
}
</style>

</head>

<body>

<h2>Your Cart</h2>

<% if (!cart || cart.items.length === 0) { %>

<p class="empty">Your cart is empty.</p>

<% } else { %>

<table>
<tr>
    <th>Product</th>
    <th>Price</th>
    <th>Quantity</th>
    <th>Total</th>
</tr>

<% cart.items.forEach(item => { %>

<tr>
    <td><%= item.product.name %></td>
    <td>₹<%= item.product.price %></td>
    <td><%= item.quantity %></td>
    <td>₹<%= item.product.price * item.quantity %></td>
</tr>

<% }) %>

</table>

<h3>Total: ₹<%= grandTotal || 0 %></h3>
<br>

<label>Shipping Address:</label><br>

<input 
type="text"
id="address"
placeholder="Enter your address"
required
style="width:50%; padding:8px;"
>

<br><br>

<button id="pay-btn" class="btn">Pay & Place Order</button>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

const totalAmount = Number("<%= grandTotal %>");
const razorpayKey = "<%= razorpayKey %>";

const payBtn = document.getElementById("pay-btn");

payBtn.onclick = async function () {

    const address = document.getElementById("address").value;

    if (!address) {
        alert("Please enter shipping address");
        return;
    }

    const response = await fetch("/create-order", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            amount: totalAmount
        })
    });

    const order = await response.json();

    var options = {

        key: razorpayKey,
        amount: order.amount,
        currency: "INR",
        order_id: order.id,

        handler: async function (response) {

            await fetch("/user/checkout", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    paymentId: response.razorpay_payment_id,
                    orderId: response.razorpay_order_id,
                    address: address
                })
            });

            alert("Payment Successful!");

            window.location.href = "/orders";
        }

    };

    var rzp = new Razorpay(options);

    rzp.open();
};

</script>

<% } %>

</body>
</html>